// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
{
	"bsonType": "object",
	"required": ["token","uid","expireAt","deviceType"],
	"permission": {
		"read": true,
		"create": true,
		"update": true,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"token": {
			"defaultValue":"",
			"bsonType": "string"
		},
		"uid": {
			"defaultValue":"",
			"bsonType": "string"
		},
		"openid": {
			"defaultValue":"",
			"bsonType": "string"
		},
		"expireAt": {
			"defaultValue":0,
			"bsonType": "double"
		},
		"deviceType": {
			"defaultValue":"",
			"bsonType": "string"
		}
	}
}