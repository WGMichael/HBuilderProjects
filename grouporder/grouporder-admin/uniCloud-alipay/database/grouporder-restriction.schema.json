{
  "bsonType": "object",
  "required": [
    "case_no",
    "target_uid",
    "action_type",
    "reason",
    "operator_uid"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "description": "发布者警告与发布限制处置流水表。当前状态存于 grouporder-user-ext",
  "properties": {
    "_id": {
      "description": "存储文档 ID（处置 ID），系统自动生成"
    },
    "case_no": {
      "bsonType": "string",
      "title": "处置编号",
      "description": "全局唯一",
      "minLength": 1,
      "maxLength": 32
    },
    "target_uid": {
      "bsonType": "string",
      "title": "被处置发布者",
      "foreignKey": "uni-id-users._id",
      "description": "被处置的发布者"
    },
    "action_type": {
      "bsonType": "int",
      "title": "处置类型",
      "description": "警告是处置记录，不改变账号状态（OPS §7）",
      "enum": [
        {
          "value": 1,
          "text": "警告"
        },
        {
          "value": 2,
          "text": "临时限制发布"
        },
        {
          "value": 3,
          "text": "永久限制发布"
        },
        {
          "value": 4,
          "text": "解除限制"
        }
      ]
    },
    "violation_type": {
      "bsonType": "string",
      "title": "违规类型",
      "description": "违规分类",
      "maxLength": 100
    },
    "reason": {
      "bsonType": "string",
      "title": "处置原因",
      "description": "处置原因，提交前必填",
      "maxLength": 500
    },
    "related_report_id": {
      "bsonType": "string",
      "title": "关联举报",
      "foreignKey": "grouporder-report._id",
      "description": "处置依据的举报"
    },
    "effective_from": {
      "bsonType": "timestamp",
      "title": "限制生效时间",
      "description": "限制生效时间"
    },
    "effective_to": {
      "bsonType": "timestamp",
      "title": "限制截止时间",
      "description": "限制截止时间"
    },
    "operator_uid": {
      "bsonType": "string",
      "title": "操作人",
      "foreignKey": "uni-id-users._id",
      "description": "执行处置的运营账号"
    },
    "prev_status": {
      "bsonType": "int",
      "title": "处置前发布权限",
      "description": "0正常 1临时限制 2永久限制",
      "enum": [
        {
          "value": 0,
          "text": "正常"
        },
        {
          "value": 1,
          "text": "临时限制发布"
        },
        {
          "value": 2,
          "text": "永久限制发布"
        }
      ]
    },
    "next_status": {
      "bsonType": "int",
      "title": "处置后发布权限",
      "description": "0正常 1临时限制 2永久限制",
      "enum": [
        {
          "value": 0,
          "text": "正常"
        },
        {
          "value": 1,
          "text": "临时限制发布"
        },
        {
          "value": 2,
          "text": "永久限制发布"
        }
      ]
    },
    "create_date": {
      "bsonType": "timestamp",
      "title": "处置时间",
      "description": "处置时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}
